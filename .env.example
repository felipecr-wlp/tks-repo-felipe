# ─────────────────────────────────────────────────────────────
# Work OS — Variables de entorno
# Copiar a .env.local y rellenar con valores reales
# NUNCA commitear .env.local al repositorio
# ─────────────────────────────────────────────────────────────

# Supabase — solo estos dos van con NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase — service role: NUNCA al cliente
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Google Gemini AI (Google Cloud Console → APIs & Services)
GEMINI_API_KEY=AIza...

# Upstash Redis — rate limiting (upstash.com, free tier)
#
# En PRODUCCIÓN estas dos NO se ponen a mano: la integración de Upstash del
# Marketplace de Vercel inyecta KV_REST_API_URL y KV_REST_API_TOKEN, y el
# código las prefiere. Estas de abajo son para desarrollo local.
#
# Si copias el token desde el panel de Upstash, usa el de ESCRITURA. El
# KV_REST_API_READ_ONLY_TOKEN no sirve: el rate limiter incrementa contadores.
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...

# Domain restriction — emails que pueden hacer login
# Ej: "empresa.com" → solo @empresa.com pueden acceder
ALLOWED_EMAIL_DOMAIN=tudominio.com

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
